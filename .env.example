# =============================================================================
# ABP Bot TikTok — Environment Configuration
# =============================================================================
# Copy this file to .env and adjust values for your environment.

# --- Required ----------------------------------------------------------------

# Human-readable name for this bot instance (used in PostgreSQL bot_config)
BOT_NAME=bot-tiktok-01

# PostgreSQL connection string (DSN)
POSTGRES_DSN=postgres://postgres:postgres@localhost:5432/sls_tiktok?sslmode=disable

# GPM (GoLogin Profile Manager) API base URL
GPM_API=http://localhost:50325/api/v1

# Org ID used to filter the tbl_posts lookup run at startup
ORG_ID=987700

# Only fetch tbl_posts with pub_time greater than this (unix seconds)
PUB_TIME=1785517201

# --- Optional (defaults shown) -----------------------------------------------

# Comma-separated GPM profile IDs (empty = local Chrome without GPM)
# PROFILE_IDS=profile-1,profile-2

# Backend API base URL for pushing crawled videos (empty = push disabled)
# API_URL=http://localhost:8080/api

# Directory for output data and logs
# OUTPUT_DIR=./data

# Enable debug mode (run once immediately instead of scheduled intervals)
# DEBUG=false

# --- Logging -----------------------------------------------------------------

# Minimum log level: debug | info | warn | error
# LOG_LEVEL=info

# Maximum log file size in MB before rotation
# LOG_MAX_SIZE_MB=100

# Maximum number of days to retain old log files
# LOG_MAX_AGE_DAYS=7

# Maximum number of rotated log files to keep
# LOG_MAX_BACKUPS=7

# --- PostgreSQL pool ----------------------------------------------------------

# Maximum concurrent PostgreSQL connections
# POSTGRES_MAX_POOL_SIZE=100

# Minimum idle PostgreSQL connections to maintain
# POSTGRES_MIN_POOL_SIZE=10

# --- API client --------------------------------------------------------------

# HTTP request timeout in seconds
# HTTP_TIMEOUT_SECONDS=30

# --- Crawl timing (seconds) --------------------------------------------------

# Sleep range between URL visits (min–max)
# SLEEP_MIN_KEYWORD=60
# SLEEP_MAX_KEYWORD=180

# Rest range between full crawl sessions (min–max)
# REST_MIN_SESSION=180
# REST_MAX_SESSION=300

# --- Batch limits ------------------------------------------------------------

# Number of URLs to visit per browser session (min–max)
# BATCH_MIN=3
# BATCH_MAX=5

# --- Pagination guards -------------------------------------------------------

# Maximum scroll pages per crawl session
# MAX_PAGES_PER_SESSION=20
